<ContextMenu xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="202" Padding="6" Background="Transparent" HasDropShadow="False" StaysOpen="False"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
 TextOptions.TextFormattingMode="Display" KeyboardNavigation.DirectionalNavigation="Cycle"
 AutomationProperties.Name="额度悬浮窗菜单">
 <ContextMenu.Resources>
  <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>
  <SolidColorBrush x:Key="Panel" Color="#151A18"/>
  <SolidColorBrush x:Key="Edge" Color="#3A453F"/>
  <SolidColorBrush x:Key="Ink" Color="#EFF5F1"/>
  <SolidColorBrush x:Key="Muted" Color="#AAB9B0"/>
  <SolidColorBrush x:Key="Accent" Color="#55E4A5"/>
  <SolidColorBrush x:Key="Hover" Color="#26372E"/>
  <SolidColorBrush x:Key="HoverMark" Color="#55E4A5"/>
  <SolidColorBrush x:Key="HoverInk" Color="#F2FAF5"/>
  <SolidColorBrush x:Key="Card" Color="#1E2822"/>
  <SolidColorBrush x:Key="TrackInk" Color="#55675C"/>
  <SolidColorBrush x:Key="Knob" Color="#DBF8E9"/>
  <SolidColorBrush x:Key="ExitHover" Color="#372927"/>
  <SolidColorBrush x:Key="ExitInk" Color="#F4B6A9"/>
  <Style x:Key="Glyph" TargetType="Path">
   <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
   <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
   <Setter Property="StrokeThickness" Value="1.5"/><Setter Property="StrokeLineJoin" Value="Round"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
   <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="MenuItem">
     <Border x:Name="Row" MinHeight="32" Padding="10,0" CornerRadius="7" Background="Transparent">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ContentPresenter x:Name="Mark" ContentSource="Icon" TextElement.Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
       <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
       <TextBlock x:Name="Hint" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
       <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
       <Setter Property="Foreground" Value="{DynamicResource HoverInk}"/>
       <Setter TargetName="Mark" Property="TextElement.Foreground" Value="{DynamicResource HoverMark}"/>
       <Setter TargetName="Hint" Property="Foreground" Value="{DynamicResource HoverInk}"/>
      </Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Exit"/><Condition Property="IsHighlighted" Value="True"/></MultiTrigger.Conditions>
       <Setter TargetName="Row" Property="Background" Value="{DynamicResource ExitHover}"/>
       <Setter TargetName="Mark" Property="TextElement.Foreground" Value="{DynamicResource ExitInk}"/>
      </MultiTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <ControlTemplate x:Key="RailButton" TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="22"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent">
     <Border Height="4" Margin="7,0" Background="{DynamicResource TrackInk}" CornerRadius="2"/>
     <Track x:Name="PART_Track" Focusable="False">
      <Track.DecreaseRepeatButton>
       <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
        <Grid Background="Transparent"><Border Height="4" Margin="7,0,-7,0" Background="{DynamicResource Accent}" CornerRadius="2"/></Grid>
       </ControlTemplate></RepeatButton.Template></RepeatButton>
      </Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="14" Height="22" Focusable="False" Cursor="Hand">
       <Thumb.Template><ControlTemplate TargetType="Thumb">
        <Grid Background="Transparent"><Ellipse Width="13" Height="13" Fill="{DynamicResource Knob}" Stroke="{DynamicResource Accent}" StrokeThickness="1.2"/></Grid>
       </ControlTemplate></Thumb.Template>
      </Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Template="{StaticResource RailButton}"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ContextMenu.Resources>
 <ContextMenu.Template><ControlTemplate TargetType="ContextMenu">
  <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
   <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
  </Border>
 </ControlTemplate></ContextMenu.Template>
 <MenuItem x:Name="RefreshItem" Header="立即刷新" InputGestureText="F5">
  <MenuItem.Icon><Path Style="{StaticResource Glyph}" Data="M14.8,7.4 A6.05,6.05 0 1 0 14.7,11.6 M14.8,3.5 V7.5 H10.8"/></MenuItem.Icon>
 </MenuItem>
 <MenuItem x:Name="TransparencyRow" StaysOpenOnClick="True" AutomationProperties.Name="背景透明度">
  <MenuItem.Template><ControlTemplate TargetType="MenuItem">
   <Border x:Name="Setting" Margin="1,4" Padding="9,6,9,3" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Edge}" Background="{DynamicResource Card}">
    <ContentPresenter ContentSource="Header"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Setting" Property="BorderBrush" Value="{DynamicResource TrackInk}"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Setting" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></MenuItem.Template>
  <MenuItem.Header><Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Path Grid.Column="0" Style="{StaticResource Glyph}" TextElement.Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
    Data="M9,2 C7.5,4.6 3.9,8 3.9,10.7 A5.1,5.1 0 0 0 14.1,10.7 C14.1,8 10.5,4.6 9,2 Z M6.7,11 Q6.9,12.7 8.6,13.1"/>
   <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Text="背景透明度" Foreground="{DynamicResource Ink}"/>
   <TextBlock x:Name="CurrentPercent" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Accent}"/>
   <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,2,0,0"
    Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
    AutomationProperties.Name="背景透明度" AutomationProperties.HelpText="0% 为背景不透明，100% 为背景全透明"/>
  </Grid></MenuItem.Header>
 </MenuItem>
 <MenuItem x:Name="HideItem" Header="隐藏到托盘">
  <MenuItem.Icon><Path Style="{StaticResource Glyph}" Data="M2.8,11.9 V13.7 Q2.8,15 4.1,15 H13.9 Q15.2,15 15.2,13.7 V11.9 M9,2.5 V10.9 M5.7,7.8 L9,11.1 L12.3,7.8"/></MenuItem.Icon>
 </MenuItem>
 <MenuItem x:Name="ShowItem" Header="显示悬浮窗" Visibility="Collapsed">
  <MenuItem.Icon><Path Style="{StaticResource Glyph}" Data="M4.1,3.7 H13.9 Q15.3,3.7 15.3,5.1 V12.9 Q15.3,14.3 13.9,14.3 H4.1 Q2.7,14.3 2.7,12.9 V5.1 Q2.7,3.7 4.1,3.7 Z M3,7.4 H15 M5.6,10.7 H8.7"/></MenuItem.Icon>
 </MenuItem>
 <MenuItem x:Name="ExitItem" Header="退出" Tag="Exit">
  <MenuItem.Icon><Path Style="{StaticResource Glyph}" Data="M9,2.2 V8.4 M5.5,4.35 A6.05,6.05 0 1 0 12.5,4.35"/></MenuItem.Icon>
 </MenuItem>
</ContextMenu>
