<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib"
 Margin="2" MaxWidth="232" MaxHeight="600" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
 KeyboardNavigation.TabNavigation="Cycle" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI"
 TextElement.Foreground="#F0F3F1">
 <DockPanel.Resources>
  <sys:Double x:Key="BackdropOpacity">1</sys:Double>
  <Style x:Key="KeyboardFocusRing" TargetType="Control">
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Control">
     <Border Margin="1" CornerRadius="8" BorderThickness="1" BorderBrush="#63E9B0" IsHitTestVisible="False"/>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#F0F3F1"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Grid Background="Transparent">
      <Border x:Name="surface" CornerRadius="9" Background="{TemplateBinding Background}" Opacity="{DynamicResource BackdropOpacity}" IsHitTestVisible="False"/>
      <Border BorderThickness="1" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#242C29"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </DockPanel.Resources>
 <!-- A one-alpha underlay keeps blank areas clickable on a Windows layered HWND. -->
 <Border x:Name="Summary" DockPanel.Dock="Top" Width="104" Height="54" HorizontalAlignment="Center" CornerRadius="13" Background="#01000000">
  <Grid>
   <Border x:Name="SummaryBackdrop" CornerRadius="13" Background="#101312" BorderBrush="#35403A" BorderThickness="1" Opacity="{DynamicResource BackdropOpacity}" IsHitTestVisible="False"/>
   <Grid Height="48" Margin="3">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="CodexButton"/>
    <Border Grid.Column="1" Height="24" Background="#333B37" Opacity="{DynamicResource BackdropOpacity}"/>
    <Button x:Name="GravityButton" Grid.Column="2"/>
   </Grid>
  </Grid>
 </Border>
 <DockPanel x:Name="Drawer" Width="232" VerticalAlignment="Top" Visibility="Collapsed">
  <Grid x:Name="PointerStrip" DockPanel.Dock="Top" Height="8" Width="{Binding ActualWidth, ElementName=Summary}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Path x:Name="Pointer" HorizontalAlignment="Center" VerticalAlignment="Bottom" Data="M 0,7 L 5,2 Q 7,0 9,2 L 14,7 Z" Fill="#141816" Opacity="{DynamicResource BackdropOpacity}"/>
  </Grid>
  <Border Background="#01000000" CornerRadius="14">
   <Grid>
    <Border x:Name="DetailsBackdrop" Background="#141816" BorderBrush="#36413B" BorderThickness="1" CornerRadius="14" Opacity="{DynamicResource BackdropOpacity}" IsHitTestVisible="False"/>
    <Grid Margin="12,8,12,6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Height="29">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
     <Grid Width="26" Height="26">
      <Border CornerRadius="8" Background="#21352B" Opacity="{DynamicResource BackdropOpacity}"/>
      <Border x:Name="HeaderIcon"/>
     </Grid>
     <TextBlock x:Name="Heading" Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
     <Button x:Name="Fold" Grid.Column="2" Height="28" Padding="0" ToolTip="收起详情（Esc）" AutomationProperties.Name="收起详情">
      <Path Data="M 1,7 L 6,2 L 11,7" Stroke="#B2BDB6" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     </Button>
    </Grid>
    <ScrollViewer x:Name="InfoScroll" Grid.Row="1" MaxHeight="450" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock x:Name="Notice" TextWrapping="Wrap" Visibility="Collapsed" Margin="1,10,0,4" FontSize="12" Foreground="#F1CB8E"/>
      <StackPanel x:Name="Rows"/>
     </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Height="1" Background="#313933" Margin="0,8,0,1" Opacity="{DynamicResource BackdropOpacity}"/>
    <Grid Grid.Row="3" Height="28">
     <TextBlock x:Name="Status" FontSize="11.5" Foreground="#AFBAB3" VerticalAlignment="Center" Margin="1,0,30,0"/>
     <Button x:Name="Refresh" Width="30" Height="28" Padding="0" HorizontalAlignment="Right" ToolTip="立即刷新" AutomationProperties.Name="立即刷新">
      <Path Data="M 13,5 A 5.8,5.8 0 1 0 13.6,10.2 M 13,1 L 13,5.5 L 8.5,5.5" Stroke="#B4C1B8" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
     </Button>
    </Grid>
    </Grid>
   </Grid>
  </Border>
 </DockPanel>
</DockPanel>
