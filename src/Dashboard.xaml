<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Margin="2" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
 KeyboardNavigation.TabNavigation="Cycle" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI"
 TextElement.Foreground="#F0F3F1">
 <StackPanel.Resources>
  <Style x:Key="KeyboardFocusRing" TargetType="Control">
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Control">
     <Border Margin="1" CornerRadius="8" BorderThickness="1" BorderBrush="#63E9B0" IsHitTestVisible="False"/>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#F0F3F1"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="surface" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#242C29"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Background" Value="#303C35"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </StackPanel.Resources>
 <Border x:Name="Summary" Width="124" HorizontalAlignment="Center" CornerRadius="15" Background="#101312" BorderBrush="#35403A" BorderThickness="1" Padding="3">
  <Grid Height="56">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Button x:Name="CodexButton"/>
   <Border Grid.Column="1" Height="29" Background="#333B37"/>
   <Button x:Name="GravityButton" Grid.Column="2"/>
  </Grid>
 </Border>
 <StackPanel x:Name="Drawer" Visibility="Collapsed">
  <Grid Height="8" Width="{Binding ActualWidth, ElementName=Summary}" HorizontalAlignment="Center">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Path x:Name="Pointer" HorizontalAlignment="Center" VerticalAlignment="Bottom" Data="M 0,7 L 5,2 Q 7,0 9,2 L 14,7 Z" Fill="#141816"/>
  </Grid>
  <Border Background="#141816" BorderBrush="#36413B" BorderThickness="1" CornerRadius="15" Padding="12,8,12,5">
   <StackPanel>
    <Grid Height="29">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
     <Border x:Name="HeaderIcon" Width="26" Height="26" CornerRadius="8" Background="#21352B"/>
     <TextBlock x:Name="Heading" Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
     <Button x:Name="Fold" Grid.Column="2" Height="28" Padding="0" ToolTip="收起详情（Esc）" AutomationProperties.Name="收起详情">
      <Path Data="M 1,7 L 6,2 L 11,7" Stroke="#B2BDB6" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     </Button>
    </Grid>
    <ScrollViewer x:Name="InfoScroll" MaxHeight="450" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock x:Name="Notice" TextWrapping="Wrap" Visibility="Collapsed" Margin="1,10,0,4" FontSize="12" Foreground="#F1CB8E"/>
      <StackPanel x:Name="Rows"/>
     </StackPanel>
    </ScrollViewer>
    <Border Height="1" Background="#313933" Margin="0,8,0,1"/>
    <Grid Height="28">
     <TextBlock x:Name="Status" FontSize="11.5" Foreground="#AFBAB3" VerticalAlignment="Center" Margin="1,0,30,0"/>
     <Button x:Name="Refresh" Width="30" Height="28" Padding="0" HorizontalAlignment="Right" ToolTip="立即刷新" AutomationProperties.Name="立即刷新">
      <Path Data="M 13,5 A 5.8,5.8 0 1 0 13.6,10.2 M 13,1 L 13,5.5 L 8.5,5.5" Stroke="#B4C1B8" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
     </Button>
    </Grid>
   </StackPanel>
  </Border>
 </StackPanel>
</StackPanel>
